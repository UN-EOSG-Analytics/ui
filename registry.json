        {
          "path": "public/images/un-emblem-colour.svg",
          "type": "registry:file",
          "target": "public/images/un-emblem-colour.svg"
        },
        {
          "path": "public/images/un-logo-en-reverse.svg",
          "type": "registry:file",
          "target": "public/images/un-logo-en-reverse.svg"
        },
        {
          "path": "public/images/un-logo-fr-reverse.svg",
          "type": "registry:file",
          "target": "public/images/un-logo-fr-reverse.svg"
        },
        {
          "path": "public/images/un-logo-es-reverse.svg",
          "type": "registry:file",
          "target": "public/images/un-logo-es-reverse.svg"
        },
        {
          "path": "public/images/un-logo-ar-reverse.svg",
